# ── Environment Variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running locally.
# Never commit your actual .env file.

# Node environment (development | production | test)
NODE_ENV=development

# Vite exposes variables prefixed with VITE_ to the browser bundle.
# API base URL (optional — not used in this project but documented for completeness)
VITE_API_URL=http://localhost:3000/api

# Port for local dev server (Vite default is 5173)
VITE_PORT=5173
